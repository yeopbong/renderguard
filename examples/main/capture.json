{
  "beforeUrl": "http://127.0.0.1:9030/main/before.html",
  "afterUrl": "http://127.0.0.1:9030/main/after.html",
  "viewport": {
    "width": 720,
    "height": 760
  },
  "deviceScaleFactor": 1,
  "readySelector": "[data-ready]",
  "contracts": [
    {
      "type": "required-visible",
      "selector": ".move"
    },
    {
      "type": "inside-container",
      "selector": ".move",
      "container": ".frame"
    },
    {
      "type": "non-overlap",
      "selector": ".move",
      "other": ".neighbor"
    }
  ],
  "masks": [],
  "state": {
    "locale": "en-US",
    "timezoneId": "UTC",
    "colorScheme": "light",
    "fixedTime": 1700000000000,
    "randomSeed": 7
  },
  "outputDir": "workspace/main-capture"
}
